# Configure these on the API host; existing workers also use a Modal Secret
# named video-pipeline. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
S3_BUCKET=private-video-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# JSON map from opaque bearer token to stable user ID.
API_TOKENS_JSON={"replace-with-long-random-token":"mcp_user_123"}
# Session token verification for the web dashboard; use its exact frontend origin.
CLERK_OAUTH_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_WEB_ORIGIN=http://localhost:3000
# Optional OAuth integration, separate from the dashboard. See docs/AUTH.md.
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
# Hosted MCP process; set the same public origin on the Next.js server.
MCP_PUBLIC_ORIGIN=https://your-mcp-origin
MCP_FRONTEND_ORIGIN=https://your-frontend-origin
MCP_JWT_SIGNING_KEY=
# Private API address from the hosted MCP process (localhost when co-located).
MCP_API_INTERNAL_ORIGIN=http://127.0.0.1:8000
# Optional comma-separated browser origins if clients call the API directly.
CORS_ORIGINS=
# Clerk Backend API key. Required to keep the credit wallet in sync with Clerk
# Billing account credits (starter grant, reserve, refund). Without it, every
# paid request from a Clerk user fails with 503. Enable Billing credits for the
# instance in the Clerk dashboard first. Server-side only; never ship to clients.
CLERK_SECRET_KEY=
# Gemini API key for the creative agent (prompt optimization and image
# generation). Server-side only; the frontend must never receive it.
GEMINI_API_KEY=
# Optional creative model overrides; these are the defaults.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional model for creator video review in the verification worker.
GEMINI_MODEL=gemini-2.5-flash
# Needed only if your Hugging Face account must access gated Gemma 3 weights.
HF_TOKEN=
