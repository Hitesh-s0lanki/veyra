# Add these values to a Modal Secret named video-pipeline. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
S3_BUCKET=private-video-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# JSON map from opaque bearer token to stable user ID.
API_TOKENS_JSON={"replace-with-long-random-token":"user_123"}
# Needed only if your Hugging Face account must access gated Gemma 3 weights.
HF_TOKEN=
